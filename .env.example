# ── Chat model: choose ollama (local) or deepseek (cloud) ─────────
# Ollama is the safe first-run default. Install Ollama and run:
#   ollama pull qwen3:4b-instruct
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct

# For DeepSeek, set LLM_PROVIDER=deepseek and add your own key below.
# Never commit the real .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── Local web server security ────────────────────────────────────
# This single-user demo rejects non-loopback hosts; do not expose it on a LAN.
APP_HOST=127.0.0.1
APP_PORT=8001
# Avoid extra browser origins when storing sensitive records.
# APP_ALLOWED_ORIGINS=http://127.0.0.1:3000

# ── Optional RAG over local knowledge_base/ files ──────────────────
# RAG needs a separate embedding model even when the chat model is local.
# Keep disabled until you run: ollama pull qwen3-embedding:4b
RAG_ENABLED=false
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_API_KEY=only_for_openai_compatible_endpoints
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.55
RAG_MAX_CONTEXT_CHARS=4000
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150

# ── Conversation Memory 2.0 ──────────────────────────────
MEMORY_ENABLED=true
MEMORY_RECENT_MESSAGES=12
MEMORY_SUMMARY_TRIGGER_MESSAGES=16
MEMORY_SUMMARY_KEEP_RECENT=8
MEMORY_SUMMARY_MAX_CHARS=2000
MEMORY_MAX_RETRIEVED=4
MEMORY_EXTRACTION_ENABLED=true
